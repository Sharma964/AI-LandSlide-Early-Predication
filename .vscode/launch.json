{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI Backend (Uvicorn - Port 8001)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "backend.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8001",
        "--reload"
      ],
      "jinja": true,
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Debug Frontend (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src",
      "preLaunchTask": "Start Frontend (Vite)"
    },
    {
      "name": "Debug Frontend (Edge)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src",
      "preLaunchTask": "Start Frontend (Vite)"
    },
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Train ML Models Pipeline",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/ml/train.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Precompute 77 Districts Predictions",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/scripts/precompute_districts.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: Backend + Frontend (Chrome)",
      "configurations": [
        "FastAPI Backend (Uvicorn - Port 8001)",
        "Debug Frontend (Chrome)"
      ],
      "stopAll": true
    },
    {
      "name": "Full Stack: Backend + Frontend (Edge)",
      "configurations": [
        "FastAPI Backend (Uvicorn - Port 8001)",
        "Debug Frontend (Edge)"
      ],
      "stopAll": true
    }
  ]
}
